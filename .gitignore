# Unity3D generated meta files
# UYARI: Meta dosyaları normalde ignore EDİLMEMELİDİR.
# Ancak bazen silinen klasörlerin meta dosyaları kalabilir,
# yine de bu kısmı boş bırakmak en sağlıklısıdır.
# *.pidb.meta
# *.pdb.meta
# *.mdb.meta

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/

# Gradle settings
.gradle/

